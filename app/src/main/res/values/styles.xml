<resources>

    <style name="Widget.Theme.Util.MyView" parent="" />

    <!-- Primary filled button used across screens -->
    <style name="Widget.Util.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Danger / stop button -->
    <style name="Widget.Util.Button.Danger" parent="Widget.Material3.Button">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- Tonal button for secondary actions -->
    <style name="Widget.Util.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Section heading (e.g. "No of Calls") -->
    <style name="Text.Util.SectionLabel" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Helper / description text under a control -->
    <style name="Text.Util.Info" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:lineSpacingExtra">2dp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Quick action tile on the redialer screen -->
    <style name="Widget.Util.QuickAction" parent="Widget.Material3.Button">
        <item name="android:minHeight">64dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:padding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <!-- Feature Hub row item -->
    <style name="Widget.Util.FeatureItem" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">14dp</item>
    </style>
</resources>
