<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.util.features.FeatureHubActivity">

    <include
        android:id="@+id/include"
        layout="@layout/app_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/feature_hub_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/feature_hub_desc"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp" />

            <TextView
                style="@style/Text.Util.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/feature_group_messaging" />

            <Button
                android:id="@+id/feature_templates"
                style="@style/Widget.Util.FeatureItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/md_primary_container"
                android:text="@string/feature_templates"
                android:textColor="@color/md_on_primary_container"
                android:textStyle="bold" />

            <Button
                android:id="@+id/feature_multi_sms"
                style="@style/Widget.Util.FeatureItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/md_primary_container"
                android:text="@string/feature_multi_sms"
                android:textColor="@color/md_on_primary_container"
                android:textStyle="bold" />

            <Button
                android:id="@+id/feature_schedule"
                style="@style/Widget.Util.FeatureItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/md_primary_container"
                android:text="@string/feature_schedule"
                android:textColor="@color/md_on_primary_container"
                android:textStyle="bold" />

            <TextView
                style="@style/Text.Util.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/feature_group_calling" />

            <Button
                android:id="@+id/feature_direct_dial"
                style="@style/Widget.Util.FeatureItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/md_primary_container"
                android:text="@string/feature_direct_dial"
                android:textColor="@color/md_on_primary_container"
                android:textStyle="bold" />

            <Button
                android:id="@+id/feature_clipboard_dial"
                style="@style/Widget.Util.FeatureItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/md_primary_container"
                android:text="@string/feature_clipboard_dial"
                android:textColor="@color/md_on_primary_container"
                android:textStyle="bold" />

            <TextView
                style="@style/Text.Util.SectionLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/feature_group_data" />

            <Button
                android:id="@+id/feature_history"
                style="@style/Widget.Util.FeatureItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/md_primary_container"
                android:text="@string/feature_history"
                android:textColor="@color/md_on_primary_container"
                android:textStyle="bold" />

            <Button
                android:id="@+id/feature_device_info"
                style="@style/Widget.Util.FeatureItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/md_primary_container"
                android:text="@string/feature_device_info"
                android:textColor="@color/md_on_primary_container"
                android:textStyle="bold" />

            <Button
                android:id="@+id/feature_backup"
                style="@style/Widget.Util.FeatureItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/md_primary_container"
                android:text="@string/feature_backup"
                android:textColor="@color/md_on_primary_container"
                android:textStyle="bold" />

            <Button
                android:id="@+id/feature_theme"
                style="@style/Widget.Util.FeatureItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/md_primary_container"
                android:text="@string/feature_theme"
                android:textColor="@color/md_on_primary_container"
                android:textStyle="bold" />

            <Button
                android:id="@+id/feature_clear_data"
                style="@style/Widget.Util.Button.Danger"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/md_error"
                android:text="@string/feature_clear_data"
                android:textColor="@color/md_on_error" />

            <Button
                android:id="@+id/feature_call_timer"
                style="@style/Widget.Util.FeatureItem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/md_primary_container"
                android:text="@string/feature_call_timer"
                android:textColor="@color/md_on_primary_container"
                android:textStyle="bold" />

            <Button
                android:id="@+id/feature_back"
                style="@style/Widget.Util.Button.Tonal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="@string/feature_back" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
