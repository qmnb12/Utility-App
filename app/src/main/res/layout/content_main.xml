<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="28dp">

        <TextView
            android:id="@+id/home_intro_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_intro_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/home_intro_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/home_intro_desc"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <Button
            android:id="@+id/automatic_redialer"
            style="@style/Widget.Util.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="28dp"
            android:text="@string/automatic_redialer" />

        <TextView
            android:id="@+id/home_redialer_desc"
            style="@style/Text.Util.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:text="@string/home_redialer_desc" />

        <Button
            android:id="@+id/message_sender"
            style="@style/Widget.Util.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/message_sender" />

        <TextView
            android:id="@+id/home_message_sender_desc"
            style="@style/Text.Util.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:text="@string/home_message_sender_desc" />

        <Button
            android:id="@+id/feature_hub"
            style="@style/Widget.Util.Button.Tonal"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/feature_hub_button" />

        <TextView
            android:id="@+id/home_tools_desc"
            style="@style/Text.Util.Info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:text="@string/home_tools_desc" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
