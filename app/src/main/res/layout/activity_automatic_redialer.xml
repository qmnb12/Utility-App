<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/include"
        layout="@layout/app_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/constraintLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="24dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            tools:context="com.util.automaticredialer.AutomaticRedialerActivity">

            <Button
                android:id="@+id/ar_select_contact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/color30_dark"
                android:clickable="true"
                android:padding="12dp"
                android:text="@string/ar_select_contact"
                android:textAllCaps="false"
                android:textSize="16sp" />

            <LinearLayout
                android:id="@+id/ar_manual_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/ar_country_code_spinner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:entryValues="@array/country_codes"
                    android:backgroundTint="@color/color10_light" />

                <EditText
                    android:id="@+id/ar_manual_number"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:hint="@string/ar_manual_number_hint"
                    android:inputType="phone"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/ar_no_of_calls_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ar_no_of_calls"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/ar_no_of_calls"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:inputType="number"
                android:text="10"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/ar_call_gap_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ar_call_gap"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/ar_call_gap"
                android:layout_width="70dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:inputType="number"
                android:text="5"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/ar_hint_disconnect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ar_disconnect_mode"
                android:textColor="@android:color/black"
                android:textSize="14sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/ar_disconnect_mode_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical">

                <RadioButton
                    android:id="@+id/ar_mode_off"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/ar_mode_off"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/ar_mode_direct"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/ar_mode_direct"
                    android:textSize="16sp" />

                <RadioButton
                    android:id="@+id/ar_mode_pickup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/ar_mode_pickup"
                    android:textSize="16sp" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/ar_disconnect_time_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/ar_disconnect_sec_label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/ar_disconnect_sec"
                    android:textColor="@android:color/black"
                    android:textSize="14sp" />

                <EditText
                    android:id="@+id/ar_disconnect_sec"
                    android:layout_width="70dp"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="5"
                    android:textColor="@android:color/black"
                    android:textSize="16sp"
                    android:gravity="center" />
            </LinearLayout>

            <EditText
                android:id="@+id/ar_batch_numbers"
                android:layout_width="match_parent"
                android:layout_height="80dp"
                android:layout_marginTop="12dp"
                android:hint="@string/ar_batch_numbers_hint"
                android:inputType="textMultiLine"
                android:lines="2"
                android:gravity="top|start"
                android:textColor="@android:color/black"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/ar_current_call_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/ar_current_no_of_call"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold" />

            <CheckBox
                android:id="@+id/ar_ussd_mode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ar_ussd_mode"
                android:textColor="@android:color/black"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/ar_run_in_background"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/ar_run_in_background"
                android:textColor="@android:color/black"
                android:textSize="14sp" />

            <Button
                android:id="@+id/ar_button_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:backgroundTint="@color/color10_dark"
                android:padding="12dp"
                android:text="@string/ar_call"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/ar_stop_call"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/color30_light"
                android:padding="12dp"
                android:text="@string/ar_stop"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textAllCaps="false" />

            <include
                android:id="@+id/main_menu"
                layout="@layout/main_menu_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>